        </mxCell>
        <mxCell id="log" value="&lt;b&gt;최소 로그&lt;/b&gt;&lt;br&gt;응답 원문 대신&lt;br&gt;객체 ID · 표식 일치 · 상태 코드" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="560" width="220" height="90" as="geometry"/>
        </mxCell>

        <!-- 4. 판정 단계 -->
