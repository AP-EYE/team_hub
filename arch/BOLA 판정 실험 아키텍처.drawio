          <mxGeometry x="1120" y="700" width="320" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="prelim" value="예비 (판정기 성능 아님): 단순 규칙 오탐 Gitea 8/18, Memos 3/6  ·  AuthzTrace 가짜 API 정탐 4, 빈 목록 오탐 4 (팀원 보고, 원본 미확인)" style="text;html=1;fontSize=11;fontColor=#64748B;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="750" width="1400" height="24" as="geometry"/>
