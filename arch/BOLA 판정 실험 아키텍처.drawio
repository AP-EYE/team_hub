        </mxCell>
        <mxCell id="b2" value="② AuthzTrace 0.6.0 원형" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0891B2;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1140" y="194" width="280" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="b3" value="③ 설정을 고친 AuthzTrace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0891B2;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1140" y="238" width="280" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="b4" value="④ 반환 객체 대조 개선안 (4번 영역)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#047857;fontSize=12;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1140" y="282" width="280" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="b5" value="보조: BACScan식 공개 필터 · AuthProbe식 목록 판정 (재구현)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;dashed=1;fontSize=11;align=left;spacingLeft=8;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="1140" y="326" width="280" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="same" value="모든 비교군에 같은 계정·객체·설정·요청" style="text;html=1;fontSize=11;fontColor=#0E7490;align=center;" vertex="1" parent="1">
          <mxGeometry x="1140" y="370" width="280" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="eval" value="&lt;b&gt;평가&lt;/b&gt;&lt;br&gt;잘못된 경고 수 · 진짜 위반 탐지 수&lt;br&gt;놓친 위반 수 (보류한 위반 포함)&lt;br&gt;판정 보류 수 · 준비·확인 시간" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFFAFE;strokeColor=#0E7490;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1140" y="440" width="280" height="100" as="geometry"/>
