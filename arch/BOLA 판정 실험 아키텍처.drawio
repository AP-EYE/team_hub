          <mxGeometry x="640" y="110" width="440" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="check" value="&lt;b&gt;4-1 응답 확인&lt;/b&gt;&lt;br&gt;정상 응답인가,&lt;br&gt;오류로 빈 목록인가" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="150" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="identify" value="&lt;b&gt;4-2 반환 객체 식별&lt;/b&gt;&lt;br&gt;객체 ID + 실험용 문구로 하나씩&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;공개 ID·제목만 vs 비공개 본문&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="870" y="150" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="compare" value="&lt;b&gt;4-3 설정과 대조&lt;/b&gt;&lt;br&gt;이 계정이 이 객체를 봐도 되는가" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#047857;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="740" y="300" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="ok" value="&lt;b&gt;정상&lt;/b&gt;&lt;br&gt;허용 객체만 / 빈 목록" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="450" width="130" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="viol" value="&lt;b&gt;위반 확정&lt;/b&gt;&lt;br&gt;금지 객체&lt;br&gt;보호 내용 반환" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="795" y="450" width="130" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="hold" value="&lt;b&gt;판정 보류&lt;/b&gt;&lt;br&gt;설정 모름·변경&lt;br&gt;객체 확인 불가" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="930" y="450" width="130" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="human" value="사람 확인 (사유 기록)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="930" y="570" width="130" height="44" as="geometry"/>
        </mxCell>

        <!-- 5. 비교와 평가 -->
        <mxCell id="zone5" value="5. 비교와 평가" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1120" y="110" width="320" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="b1" value="① 단순 규칙: 다른 계정 요청이 200이면 위반" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0891B2;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
