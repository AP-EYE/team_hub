        <!-- 하단 띠 -->
        <mxCell id="conds" value="&lt;b&gt;실험 조건&lt;/b&gt;   빈 목록  |  허용 객체만  |  금지 객체만  |  허용·금지 혼합" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="1040" height="40" as="geometry"/>
