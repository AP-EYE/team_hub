<mxfile host="app.diagrams.net">
  <diagram id="bola-judgement" name="BOLA 판정 실험 아키텍처">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="목록 조회 읽기 BOLA 판정 실험 아키텍처" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="lead" value="요청이 200으로 성공해도, 응답에 실제로 나온 객체가 그 계정이 봐도 되는 객체인지 설정 기록과 대조해 정상 / 위반 확정 / 판정 보류로 나눈다." style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1200" height="26" as="geometry"/>
        </mxCell>

        <!-- 1. 실험 준비 -->
        <mxCell id="zone1" value="1. 실험 준비" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="260" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="accounts" value="&lt;b&gt;테스트 계정&lt;/b&gt;&lt;br&gt;A 소유자 · B 권한 없음&lt;br&gt;C 공유받음 · 비로그인" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="objects" value="&lt;b&gt;테스트 객체&lt;/b&gt;&lt;br&gt;전체 공개 · 로그인 공개&lt;br&gt;비공개 · 특정 계정 공유&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;비공개 본문에 실험용 문구&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="250" width="220" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="config" value="&lt;b&gt;설정 기록&lt;/b&gt;&lt;br&gt;객체 ID · 소유자 · 공개 범위&lt;br&gt;공유 대상 · 설정 시각" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="370" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="truth" value="&lt;b&gt;평가 정답&lt;/b&gt;&lt;br&gt;앱 정책 + 실제 설정을 따로 확인&lt;br&gt;&lt;font color=&quot;#B91C1C&quot;&gt;판정기에는 주지 않음&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="220" height="90" as="geometry"/>
        </mxCell>

        <!-- 2. 대상 앱 -->
        <mxCell id="zone2" value="2. 대상 앱" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FB923C;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="340" y="110" width="260" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="gitea" value="&lt;b&gt;Gitea 28.0.0&lt;/b&gt;&lt;br&gt;저장소·이슈, 협업자 공유" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="145" width="220" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="memos" value="&lt;b&gt;Memos 0.9.0&lt;/b&gt;&lt;br&gt;PUBLIC · PROTECTED · PRIVATE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="205" width="220" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="fakeapi" value="&lt;b&gt;가짜 API&lt;/b&gt;&lt;br&gt;Memos 규칙 흉내 · 누출/차단 모드" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="265" width="220" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="endpoints" value="엔드포인트: 목록 조회 · 개별 조회" style="text;html=1;fontSize=11;fontColor=#9A3412;align=center;" vertex="1" parent="1">
          <mxGeometry x="360" y="322" width="220" height="24" as="geometry"/>
        </mxCell>

        <!-- 3. 게이트웨이 -->
        <mxCell id="gateway" value="&lt;b&gt;3. 실험 게이트웨이&lt;/b&gt;&lt;br&gt;계정별로 같은 요청 실행" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=13;" vertex="1" parent="1">
