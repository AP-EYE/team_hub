        <!-- 연결 -->
        <mxCell id="e1" value="계정별 요청" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#059669;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="accounts" target="gateway">
